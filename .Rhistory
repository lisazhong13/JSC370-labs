# Load required libraries
library(data.table)  # Efficient CSV reading
library(httr)  # API request handling
# Base URL for the CFPB Consumer Complaint Database API
base_url <- "https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/"
# Define query parameters as a list
query_params <- list(
# Filter complaints received after September 1, 2024
date_received_min = "2024-09-01",
has_narrative = "true",
product = "Credit reporting or other personal consumer reports",
format = "csv"
)
# Send GET request
cat("Downloading data...\n")
complaints_query <- GET(base_url, query = query_params)
# Read CSV content using data.table
cat("Reading data...\n")
complaints_dt <- fread(httr::content(complaints_query, as = "text"))
# Display dataset dimensions
cat("Dataset Dimensions: Rows =", nrow(complaints_dt), ", Columns =", ncol(complaints_dt), "\n")
# Show dataset preview
head(complaints_dt, 5)
complaints <- complaints_dt %>%
select("Consumer complaint narrative")
complaints
# Tokenize words
tokens <- complaints %>%
unnest_tokens(word, `Consumer complaint narrative`) %>%
filter(!word %in% stopwords("en")) %>%  # Remove stopwords
filter(!grepl("XXXX", word)) %>%  # Remove "XXXX" placeholders
filter(!grepl("xxxx", word)) %>%
filter(!grepl("xx", word)) %>%
filter(!grepl("^[0-9]+$", word))  # Remove numeric tokens
# Count token frequency
word_counts <- tokens %>%
count(word, sort = TRUE)
# View top words
print(head(word_counts, 20))
# Select top 20 most common words
top_words <- word_counts %>% top_n(20, n)
# Plot
ggplot(top_words, aes(x = reorder(word, n), y = n)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(title = "Top 20 Most Common Complaint Words",
x = "Word",
y = "Count") +
theme_minimal()
library(stringr)
# Extract complaint narratives and remove missing values
complaints_text <- complaints %>%
filter(!is.na(`Consumer complaint narrative`)) %>%
filter(str_squish(`Consumer complaint narrative`) != "")
# Tokenize text into bigrams (two-word sequences)
bigrams <- complaints_text %>%
unnest_tokens(bigram, `Consumer complaint narrative`, token = "ngrams", n = 2) %>%
mutate(bigram = tolower(bigram))  # Convert all text to lowercase
# Remove bigrams containing stopwords, numbers, or "XXXX"
bigrams_clean <- bigrams %>%
filter(!grepl("\\d+", bigram)) %>%  # Remove numeric tokens
filter(!grepl("xxxx", bigram, ignore.case = TRUE)) %>%  # Remove "XXXX" placeholders
filter(!grepl("xx", bigram, ignore.case = TRUE)) %>%  # Remove "xx" placeholders
separate(bigram, into = c("word1", "word2"), sep = " ") %>%  # Split bigrams into two words
filter(!word1 %in% stop_words$word, !word2 %in% stop_words$word) %>%  # Remove stopwords
unite(bigram, word1, word2, sep = " ")  # Recombine filtered bigrams
# Count bigram frequencies
bigram_counts <- bigrams_clean %>%
count(bigram, sort = TRUE)
# Select top 10 most common bigrams
top_bigrams <- bigram_counts %>%
slice_max(n, n = 10)
ggplot(top_bigrams, aes(x = reorder(bigram, n), y = n)) +
geom_col(fill = "dodgerblue") +
coord_flip() +
theme_bw() +
labs(
title = "Top 10 Most Common Complaint Bigrams",
x = "Bigram",
y = "Frequency"
)
library(dplyr)
library(tidytext)
# Identify top 3 most frequent issues
top_issues <- complaints_dt %>%
count(Issue, sort = TRUE) %>%
top_n(3, n) %>%
pull(Issue)
# Filter complaints to include only those in top 3 issues
complaints_filtered <- complaints_dt %>%
filter(Issue %in% top_issues)
# Tokenize complaints
tokens <- complaints_filtered %>%
unnest_tokens(word, `Consumer complaint narrative`) %>%
filter(!word %in% stopwords("en")) %>%  # Remove stopwords
filter(!grepl("XXXX|xxxx|xx", word, ignore.case = TRUE)) %>%  # Remove placeholders
filter(!grepl("^[0-9]+$", word))  # Remove numeric tokens
# Compute Term Frequency (TF-IDF)
tf_idf <- tokens %>%
count(Issue, word) %>%  # Count word occurrences per issue
bind_tf_idf(word, Issue, n) %>%  # Calculate TF-IDF
arrange(desc(tf_idf))  # Sort by highest TF-IDF value
# Select the top 5 tokens per issue based on TF-IDF
top_tf_idf_words <- tf_idf %>%
group_by(Issue) %>%
slice_max(tf_idf, n = 5)  # Select top 5 words per issue
# Display results
print(top_tf_idf_words)
library(ggplot2)
# Plot top TF-IDF words
ggplot(top_tf_idf_words, aes(x = reorder(word, tf_idf), y = tf_idf, fill = Issue)) +
geom_col(show.legend = FALSE) +
facet_wrap(~ Issue, ncol=1, scales = "free_y") +
coord_flip() +
labs(title = "Top 5 TF-IDF Words for Each Issue",
x = "Word",
y = "TF-IDF Value") +
theme_minimal()
# Tokenize complaints
tokens <- complaints_filtered %>%
unnest_tokens(word, `Consumer complaint narrative`) %>%
filter(!word %in% stopwords("en")) %>%  # Remove stopwords
# Remove purely numeric tokens
filter(!str_detect(word, "^\\d+$")) %>%
# Remove words containing numbers
filter(!str_detect(word, "\\d")) %>%
filter(str_length(word) > 1) %>%
filter(!grepl("XXXX|xxxx|xx", word, ignore.case = TRUE)) %>%  # Remove placeholders
filter(!grepl("^[0-9]+$", word))  # Remove numeric tokens
# Compute Term Frequency (TF-IDF)
tf_idf <- tokens %>%
count(Issue, word) %>%  # Count word occurrences per issue
bind_tf_idf(word, Issue, n) %>%  # Calculate TF-IDF
arrange(desc(tf_idf))  # Sort by highest TF-IDF value
# Select the top 5 tokens per issue based on TF-IDF
top_tf_idf_words <- tf_idf %>%
group_by(Issue) %>%
slice_max(tf_idf, n = 5)  # Select top 5 words per issue
# Display results
print(top_tf_idf_words)
library(ggplot2)
# Plot top TF-IDF words
ggplot(top_tf_idf_words, aes(x = reorder(word, tf_idf), y = tf_idf, fill = Issue)) +
geom_col(show.legend = FALSE) +
facet_wrap(~ Issue, ncol=1, scales = "free_y") +
coord_flip() +
labs(title = "Top 5 TF-IDF Words for Each Issue",
x = "Word",
