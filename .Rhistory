filter(!word %in% stopwords("en")) %>%  # Remove stopwords
filter(!grepl("XXXX|xx|\\d+", word, ignore.case = TRUE))  # Remove placeholders & numbers
# Join with sentiment lexicon
sentiment_analysis <- complaint_tokens %>%
inner_join(bing_lexicon, by = "word")  # 'sentiment' column will be Positive/Negative
# Count number of words classified as Positive or Negative
