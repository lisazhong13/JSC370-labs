estimated_diameter_mean = (meters_estimated_diameter_min + meters_estimated_diameter_max) / 2,
miss_distance_km = as.numeric(close_approach_data_miss_distance_kilometers),
relative_velocity_km_s = as.numeric(close_approach_data_relative_velocity_kilometers_per_second),
