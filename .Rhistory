unnest_wider(estimated_diameter) %>%  # Expand diameter into units
unnest_wider(meters, names_sep = "_") %>%  # Extract min/max in meters
unnest_wider(close_approach_data, names_sep = "_") %>%  # Extract all approach fields
unnest_wider(close_approach_data_miss_distance, names_sep = "_") %>%  # Extract miss distance
unnest_wider(close_approach_data_relative_velocity, names_sep = "_")  # Extract velocity
